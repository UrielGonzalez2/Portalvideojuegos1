<Window x:Class="Portalvideojuegos1.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iniciar Sesión - Portal de Videojuegos" Height="380" Width="400" WindowStartupLocation="CenterScreen" Background="#FAFAFA">
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="¡Bienvenido de nuevo!" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Usuario:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtUsuario" Height="30" Padding="5" Margin="0,0,0,15"/>

            <TextBlock Text="Contraseña:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtPassword" Height="30" Padding="5" Margin="0,0,0,20"/>

            <Button x:Name="btnLogin" Content="Iniciar Sesión" Height="35" Background="#7289DA" Foreground="White" FontWeight="Bold" Click="BtnLogin_Click" Margin="0,0,0,8"/>
            <Button x:Name="btnRegistrar" Content="Registrarse (Nuevo Usuario)" Height="30" Background="#43B581" Foreground="White" FontWeight="Bold" Click="BtnRegistrar_Click" Margin="0,0,0,8"/>
            <Button x:Name="btnSalir" Content="Salir" Height="30" Background="#E0E0E0" Click="BtnSalir_Click"/>
        </StackPanel>
    </Grid>
</Window>